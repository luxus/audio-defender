{
  "manifest_version": 3,
  "name": "Audio Defender",
  "version": "1.4.5",
  "description": "Boost, compress, equalize, and save free per-channel audio setups for Twitch, YouTube, Kick, and X.",
  "action": {
    "default_title": "Audio Defender",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://twitch.tv/*",
    "*://*.twitch.tv/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtu.be/*",
    "*://kick.com/*",
    "*://*.kick.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://kick.com/*",
        "*://*.kick.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "shared/presets.js",
        "shared/channel.js",
        "shared/storage.js",
        "shared/panel.js",
        "page-audio/graph.js",
        "page-audio/media.js",
        "page-audio/messaging.js",
        "page-audio/spa.js",
        "page-audio.js",
        "content.js",
        "overlay/state.js",
        "overlay/helpers.js",
        "overlay/messaging.js",
        "overlay/ui.js",
        "overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "page-audio.js"],
      "matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://kick.com/*",
        "*://*.kick.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ]
    }
  ]
}
